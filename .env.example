# ─────────────────────────────────────────────────────────────
# PulseBoard environment. Copy to `.env` and fill in.
# Bun (and Vite) load `.env` automatically.
# VITE_*  → exposed to the browser.   Others → server-only.
# ─────────────────────────────────────────────────────────────

# ── Supabase (database + auth) ───────────────────────────────
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — used ONLY by `bun run seed`. Never ship to the client.
# (Same page, "service_role" secret.)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Anthropic / Claude (Mood Map AI synthesis) ───────────────
# https://console.anthropic.com  → API Keys.  Optional: without it the
# Mood Map "Refresh" falls back to a deterministic local reshuffle.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# ── Optional: live signal sources for a production Mood Map ───
# (Not required for the app to run — wire these into src/server/moodmap.ts
#  if/when you want real trends, social and event data.)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# YOUTUBE_API_KEY=
# APIFY_TOKEN=
